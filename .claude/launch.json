{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "rest-around",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8000",
        "--bind",
        "127.0.0.1"
      ],
      "port": 8000
    },
    {
      "name": "refillit",
